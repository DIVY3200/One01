# Copy this file to .env and fill it in. Never commit .env.

# Gemini API key (https://aistudio.google.com/apikey). Without it the app runs on sample content.
GEMINI_API_KEY=

# Random secret that signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# SQLite file for local development; docker-compose overrides this with Postgres.
DATABASE_URL=sqlite+aiosqlite:///./test.db

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000"]

# Optional
HF_TOKEN=
AI_RATE_LIMIT_PER_MINUTE=30
# GEMINI_MODEL=gemini-3.5-flash-lite
